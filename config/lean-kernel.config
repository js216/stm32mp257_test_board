# Lean appliance kernel for the FFT/DRM spectrum-analyzer.
# Drops driver subsystems this single-purpose board never uses, to shrink
# /lib/modules (was ~43 MB). KEEPS: DRM-STM + LVDS, MMC/SDMMC, ext4/vfat,
# stmmac + Realtek PHY, STPMIC2. Applied as a kernel config fragment.

# Keep the LVDS bridge as a module (=m, the stock default). Forcing it =y puts
# its probe in the boot critical path where it deadlocks on the LTDC<->LVDS
# devicetree dependency cycle and hangs the kernel right after simpledrm init.
CONFIG_DRM_STM_LVDS=m
CONFIG_CPUFREQ_DT=y

# --- Sound (~4.7 MB) ---
# CONFIG_SOUND is not set
# CONFIG_SND is not set

# --- Media / V4L / DVB / cameras (~3.7 MB) ---
# CONFIG_MEDIA_SUPPORT is not set

# --- Wireless (~2.5 MB) ---
# CONFIG_WLAN is not set
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set

# --- Bluetooth (~2 MB) ---
# CONFIG_BT is not set

# --- NFC ---
# CONFIG_NFC is not set

# --- Discrete/other-vendor GPUs (keep DRM core + STM); nouveau.ko alone is 3.1 MB ---
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_RADEON is not set
# CONFIG_DRM_I915 is not set
# CONFIG_DRM_VC4 is not set

# --- Filesystems we don't use (keep ext4 + vfat) ---
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_GFS2_FS is not set
# CONFIG_NTFS3_FS is not set
# CONFIG_OCFS2_FS is not set

# --- Storage controllers this board doesn't have ---
# CONFIG_SCSI_MPT3SAS is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_ATA is not set

# --- InfiniBand / RDMA ---
# CONFIG_INFINIBAND is not set

# --- CAN bus ---
# CONFIG_CAN is not set

# --- USB networking gadgets/host NIC drivers ---
# CONFIG_USB_NET_DRIVERS is not set

# --- Wired NIC vendors we don't have (keep STMicro stmmac; Realtek *PHY* stays via CONFIG_REALTEK_PHY) ---
# CONFIG_NET_VENDOR_BROADCOM is not set
# CONFIG_NET_VENDOR_INTEL is not set
# CONFIG_NET_VENDOR_MELLANOX is not set
# CONFIG_NET_VENDOR_CHELSIO is not set
# CONFIG_NET_VENDOR_QLOGIC is not set
# CONFIG_NET_VENDOR_MARVELL is not set
# CONFIG_NET_VENDOR_MICROCHIP is not set
# CONFIG_NET_VENDOR_REALTEK is not set
# CONFIG_NET_VENDOR_AQUANTIA is not set
# CONFIG_NET_VENDOR_CAVIUM is not set
# CONFIG_NET_VENDOR_HUAWEI is not set
# CONFIG_NET_VENDOR_SOLARFLARE is not set
# CONFIG_NET_VENDOR_8390 is not set
