# Direct TF-A->Linux boot has no U-Boot and this lean image does not
# auto-load modules (see eth-builtin.config). The LTDC (DRM_STM=y) waits
# for the LVDS/DSI bridges + panel + backlight; build them in so the
# display pipeline comes up at boot without modprobe.
CONFIG_DRM_STM_LVDS=y
CONFIG_DRM_STM_DSI=y
CONFIG_DRM_PANEL_LVDS=y
CONFIG_PWM_STM32=y
CONFIG_BACKLIGHT_PWM=y
# PWM_STM32 depends on the timer MFD; build it in too.
CONFIG_MFD_STM32_TIMERS=y
# Touch path built-in: mdev cannot coldplug modules (same reason as display)
CONFIG_I2C_STM32F7=y
CONFIG_TOUCHSCREEN_ILI210X=y
# A35 PLL driver built-in: without TF-A nobody programs the CPU PLL; cpufreq-dt
# + this driver raise the cores from the ROM boot clock to the 1.2 GHz OPP
CONFIG_CLK_STM32MP2_CA35SS=y
