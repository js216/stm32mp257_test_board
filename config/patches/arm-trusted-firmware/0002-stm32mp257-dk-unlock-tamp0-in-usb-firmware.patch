From 2222222222222222222222222222222222222222 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Mon, 8 Jun 2026 12:20:00 -0700
Subject: [PATCH] stm32mp257-dk: unlock TAMP resources in USB firmware

Expose selected TAMP resources to non-secure Linux before handing off to
OP-TEE/Linux. The register offsets and bits match RM0457 and the OP-TEE
STM32 TAMP driver mappings for TAMP_SECCFGR, TAMP_PRIVCFGR, and
TAMP_RxCIDCFGR.

Signed-off-by: Codex <codex@local>
---
 plat/st/stm32mp2/bl31_plat_setup.c | 50 +++++++++++++++++++++++++++++++++++++
 1 file changed, 50 insertions(+)

diff --git a/plat/st/stm32mp2/bl31_plat_setup.c b/plat/st/stm32mp2/bl31_plat_setup.c
index c2fa48860cf..d4c44386a47 100644
--- a/plat/st/stm32mp2/bl31_plat_setup.c
+++ b/plat/st/stm32mp2/bl31_plat_setup.c
@@ -99,6 +99,56 @@ static void stm32mp25_pwr_unlock_resource(unsigned int id, const char *name)
 	       name, mmio_read_32(seccfgr), mmio_read_32(privcfgr),
 	       mmio_read_32(cidcfgr));
 }
+
+#define STM32MP25_TAMP_SECCFGR U(0x20)
+#define STM32MP25_TAMP_PRIVCFGR U(0x24)
+#define STM32MP25_TAMP_CIDCFGR(id) (U(0x80) + U(0x4) * (id))
+#define STM32MP25_TAMP_RES0_SEC BIT_32(31)
+#define STM32MP25_TAMP_RES0_PRIV BIT_32(31)
+#define STM32MP25_TAMP_RES1_SEC BIT_32(15)
+#define STM32MP25_TAMP_RES1_PRIV (BIT_32(15) | BIT_32(29))
+#define STM32MP25_TAMP_RES2_SEC BIT_32(14)
+#define STM32MP25_TAMP_RES2_PRIV (BIT_32(14) | BIT_32(30))
+
+static void stm32mp25_tamp_unlock_resource(unsigned int id, uint32_t sec_mask,
+					  uint32_t priv_mask, const char *name)
+{
+	uintptr_t seccfgr = TAMP_BASE + STM32MP25_TAMP_SECCFGR;
+	uintptr_t privcfgr = TAMP_BASE + STM32MP25_TAMP_PRIVCFGR;
+	uintptr_t cidcfgr = TAMP_BASE + STM32MP25_TAMP_CIDCFGR(id);
+	uint32_t sec = mmio_read_32(seccfgr);
+	uint32_t priv = mmio_read_32(privcfgr);
+	uint32_t cid = mmio_read_32(cidcfgr);
+
+	NOTICE("TAMP RIF: %s before sec=%x priv=%x cid=%x\n",
+	       name, sec, priv, cid);
+
+	mmio_clrbits_32(seccfgr, sec_mask);
+	mmio_clrbits_32(privcfgr, priv_mask);
+	mmio_write_32(cidcfgr, 0U);
+
+	NOTICE("TAMP RIF: %s after sec=%x priv=%x cid=%x\n",
+	       name, mmio_read_32(seccfgr), mmio_read_32(privcfgr),
+	       mmio_read_32(cidcfgr));
+}
+
+static void stm32mp25_tamp_unlock_resource0(const char *name)
+{
+	stm32mp25_tamp_unlock_resource(0U, STM32MP25_TAMP_RES0_SEC,
+				       STM32MP25_TAMP_RES0_PRIV, name);
+}
+
+static void stm32mp25_tamp_unlock_resource1(const char *name)
+{
+	stm32mp25_tamp_unlock_resource(1U, STM32MP25_TAMP_RES1_SEC,
+				       STM32MP25_TAMP_RES1_PRIV, name);
+}
+
+static void stm32mp25_tamp_unlock_resource2(const char *name)
+{
+	stm32mp25_tamp_unlock_resource(2U, STM32MP25_TAMP_RES2_SEC,
+				       STM32MP25_TAMP_RES2_PRIV, name);
+}
 #endif
 
 void bl31_early_platform_setup2(u_register_t arg0, u_register_t arg1,
@@ -374,6 +424,9 @@ entry_point_info_t *bl31_plat_get_next_image_ep_info(unsigned int type)
 		stm32mp25_pwr_unlock_resource(4U, "PWR_R4_D3_POWER");
 		stm32mp25_pwr_unlock_resource(5U, "PWR_R5_VDDIO2_MON");
 		stm32mp25_pwr_unlock_resource(6U, "PWR_R6_VDDIO1_MON");
+		stm32mp25_tamp_unlock_resource0("TAMP_RESOURCE_0");
+		stm32mp25_tamp_unlock_resource1("TAMP_RESOURCE_1");
+		stm32mp25_tamp_unlock_resource2("TAMP_RESOURCE_2");
 #endif
 		next_image_info = &bl33_image_ep_info;
 		break;
-- 
2.39.5
