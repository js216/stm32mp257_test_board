 /*
+ * Validate an independent VDDIO I/O supply domain so its pads leave the
+ * isolated (high-Z) state. Mirrors OP-TEE stm32mp25_pwr_regul.c
+ * pwr_enable_reg(): set the voltage monitor (VMEN), wait for the supply
+ * ready flag (RDY, <=10ms), then set supply-valid (SV) which connects the
+ * pads. Required when TF-A boots the OS directly (no OP-TEE/U-Boot to do it),
+ * e.g. for the SD card on VDDIO1 -- otherwise SDMMC1 pins never toggle.
+ */
+static int pwr_enable_io_supply(uint32_t cr_off, uint32_t vmen,
+				uint32_t rdy, uint32_t sv)
+{
+	uintptr_t reg = stm32mp_pwr_base() + cr_off;
+	int i;
+
+	if ((mmio_read_32(reg) & sv) != 0U) {
+		return 0;
+	}
+
+	mmio_setbits_32(reg, vmen);
+
+	for (i = 0; i < 1000; i++) {
+		if ((mmio_read_32(reg) & rdy) != 0U) {
+			break;
+		}
+		udelay(10);
+	}
+
+	if ((mmio_read_32(reg) & rdy) == 0U) {
+		mmio_clrbits_32(reg, vmen);
+		return -1;
+	}
+
+	mmio_setbits_32(reg, sv);
+	mmio_clrbits_32(reg, vmen);
+
+	return 0;
+}
+
+void stm32mp2_pwr_enable_io_supplies(void)
+{
+	if (pwr_enable_io_supply(PWR_CR8, PWR_CR8_VDDIO1VMEN,
+				 PWR_CR8_VDDIO1RDY, PWR_CR8_VDDIO1SV) != 0) {
+		WARN("PWR: VDDIO1 (SD) supply not ready\n");
+	} else {
+		NOTICE("PWR: VDDIO1 (SD) I/O domain validated\n");
+	}
+
+	if (pwr_enable_io_supply(PWR_CR7, PWR_CR7_VDDIO2VMEN,
+				 PWR_CR7_VDDIO2RDY, PWR_CR7_VDDIO2SV) != 0) {
+		WARN("PWR: VDDIO2 supply not ready\n");
+	}
+}
