 /*
+ * Enable every regulator flagged regulator-always-on / regulator-boot-on.
+ * Needed when TF-A boots the OS directly (no OP-TEE/U-Boot to turn on the
+ * PMIC rails consumed only by Linux, e.g. the SD card LDO).
+ */
+void regulator_enable_always_on(void)
+{
+	struct rdev *rdev;
+
+	for_each_registered_rdev(rdev) {
+		if ((rdev->flags & (REGUL_ALWAYS_ON | REGUL_BOOT_ON)) != 0U) {
+			if (regulator_enable(rdev) != 0) {
+				WARN("%s: enable always-on failed\n",
+				     rdev->desc->node_name);
+			}
+		}
+	}
+}
