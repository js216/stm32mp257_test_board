From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Fri, 5 Jun 2026 18:55:00 -0700
Subject: [PATCH] stm32mp2: enable PSCI CPU_ON in MP257 DK USB firmware

This Buildroot configuration is specific to STM32MP257F-DK, whose TF-A
topology exposes two Cortex-A35 cores. Include the normal STM32MP2 PSCI
power-management sources in the USB-programmer BL31 too, because this
test flow boots Linux from the USB-programmer firmware context.

Do not compile the USB programmer BL31 with null PSCI platform hooks and
do not reject PSCI CPU_ON for the secondary A35 from the generic
single-core check in this image; the Linux DT and platform topology both
describe the second core.

Signed-off-by: Codex <codex@local>
---
 plat/st/stm32mp2/bl31_plat_setup.c | 2 +-
 plat/st/stm32mp2/platform.mk        | 4 ----
 plat/st/stm32mp2/stm32mp2_pm.c     | 6 ------
 3 files changed, 1 insertion(+), 11 deletions(-)

diff --git a/plat/st/stm32mp2/bl31_plat_setup.c b/plat/st/stm32mp2/bl31_plat_setup.c
index 09cc0c9ec40..42ecb552c6e 100644
--- a/plat/st/stm32mp2/bl31_plat_setup.c
+++ b/plat/st/stm32mp2/bl31_plat_setup.c
@@ -203,7 +203,7 @@ entry_point_info_t *bl31_plat_get_next_image_ep_info(unsigned int type)
 	return next_image_info;
 }
 
-#if STM32MP_UART_PROGRAMMER || STM32MP_USB_PROGRAMMER
+#if STM32MP_UART_PROGRAMMER
 static const plat_psci_ops_t null_psci_ops;
 
 /* Stub PSCI platform functions */
diff --git a/plat/st/stm32mp2/platform.mk b/plat/st/stm32mp2/platform.mk
index 879709e1a315..485f4238aff5 100644
--- a/plat/st/stm32mp2/platform.mk
+++ b/plat/st/stm32mp2/platform.mk
@@ -299,9 +299,7 @@ PLAT_BL_COMMON_SOURCES		+=	drivers/st/clk/clk-stm32-core.c				\
 
 PLAT_BL_COMMON_SOURCES  	+=	drivers/st/nvmem/stm32mp_tamp_nvram_mp2.c
 
-ifeq ($(filter 1,${STM32MP_UART_PROGRAMMER} ${STM32MP_USB_PROGRAMMER}),)
 PLAT_BL_COMMON_SOURCES  	+=	plat/st/stm32mp2/stm32mp2_context.c
-endif
 
 BL2_SOURCES			+=	plat/st/stm32mp2/plat_bl2_mem_params_desc.c
 
@@ -389,11 +387,9 @@ BL31_SOURCES			+=	plat/st/stm32mp2/bl31_plat_setup.c			\
 					plat/st/stm32mp2/stm32mp2_topology.c
 
-ifeq ($(filter 1,${STM32MP_UART_PROGRAMMER} ${STM32MP_USB_PROGRAMMER}),)
 BL31_SOURCES			+=	plat/st/stm32mp2/stm32mp2_pm.c				\
 					common/tf_crc32.c
 
 BL31_CPPFLAGS += -march=armv8-a+crc
-endif
 
 ifeq ($(STM32MP_M33_TDCID),0)
 BL31_SOURCES			+=	drivers/st/ddr/stm32mp2_ddr_helpers.c
diff --git a/plat/st/stm32mp2/stm32mp2_pm.c b/plat/st/stm32mp2/stm32mp2_pm.c
index 8f8816bdf559..9c1658b8029c 100644
--- a/plat/st/stm32mp2/stm32mp2_pm.c
+++ b/plat/st/stm32mp2/stm32mp2_pm.c
@@ -368,10 +368,6 @@ static int stm32_pwr_domain_on(u_register_t mpidr)
 {
 	unsigned int core_id = MPIDR_AFFLVL0_VAL(mpidr);
 
-	if (stm32mp_is_single_core()) {
-		return PSCI_E_NOT_SUPPORTED;
-	}
-
 	stm32mp_state_set(core_id, STATE_START, true);
 
 	if (core_id == STM32MP_PRIMARY_CPU) {
-- 
