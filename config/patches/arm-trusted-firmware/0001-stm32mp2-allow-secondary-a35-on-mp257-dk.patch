+static void stm32mp25_rifsc_unlock_peripheral(unsigned int id, const char *name)
+{
+	uint32_t bit = BIT_32(id % 32U);
+	uintptr_t seccfgr = RIFSC_BASE + _RIFSC_RISC_SECCFGR(id);
+	uintptr_t privcfgr = RIFSC_BASE + _RIFSC_RISC_PRIVCFGR(id);
+	uintptr_t rlockr = RIFSC_BASE + _RIFSC_RISC_RCFGLOCKR(id);
+	uintptr_t cidcfgr = RIFSC_BASE + _RIFSC_RISC_PERy_CIDCFGR(id);
+	uint32_t sec = mmio_read_32(seccfgr);
+	uint32_t priv = mmio_read_32(privcfgr);
+	uint32_t rlock = mmio_read_32(rlockr);
+	uint32_t cid = mmio_read_32(cidcfgr);
+
+	NOTICE("RIFSC: %s before sec=%x priv=%x rlock=%x cid=%x\n",
+	       name, sec, priv, rlock, cid);
+
+	if (((mmio_read_32(RIFSC_BASE + _RIFSC_RISC_CR) & BIT_32(0)) != 0U) ||
+	    ((rlock & bit) != 0U)) {
+		WARN("RIFSC: %s still locked, cannot expose to non-secure world\n", name);
+		return;
+	}
+
+	mmio_clrbits_32(seccfgr, bit);
+	mmio_clrbits_32(privcfgr, bit);
+	mmio_write_32(cidcfgr, 0U);
+	mmio_write_32(RIFSC_BASE + _RIFSC_RISC_PERy_SEMCR(id), 0U);
+
+	NOTICE("RIFSC: %s after sec=%x priv=%x rlock=%x cid=%x\n",
+	       name, mmio_read_32(seccfgr), mmio_read_32(privcfgr),
+	       mmio_read_32(rlockr), mmio_read_32(cidcfgr));
+}
+
+static void stm32mp25_rcc_unlock_resource(unsigned int id, const char *name)
+{
+	uint32_t bit = BIT_32(id % 32U);
+	uintptr_t seccfgr = RCC_BASE + U(0x0) + U(0x4) * (id / 32U);
+	uintptr_t privcfgr = RCC_BASE + U(0x10) + U(0x4) * (id / 32U);
+	uintptr_t rlockr = RCC_BASE + U(0x20) + U(0x4) * (id / 32U);
+	uintptr_t cidcfgr = RCC_BASE + U(0x30) + U(0x8) * id;
+	uint32_t sec = mmio_read_32(seccfgr);
+	uint32_t priv = mmio_read_32(privcfgr);
+	uint32_t rlock = mmio_read_32(rlockr);
+	uint32_t cid = mmio_read_32(cidcfgr);
+
+	NOTICE("RCC RIF: %s before sec=%x priv=%x rlock=%x cid=%x\n",
+	       name, sec, priv, rlock, cid);
+
+	if ((rlock & bit) != 0U) {
+		WARN("RCC RIF: %s still locked, cannot expose to non-secure world\n", name);
+		return;
+	}
+
+	mmio_clrbits_32(seccfgr, bit);
+	mmio_clrbits_32(privcfgr, bit);
+	mmio_write_32(cidcfgr, 0U);
+	mmio_write_32(RCC_BASE + U(0x34) + U(0x8) * id, 0U);
+
+	NOTICE("RCC RIF: %s after sec=%x priv=%x rlock=%x cid=%x\n",
+	       name, mmio_read_32(seccfgr), mmio_read_32(privcfgr),
+	       mmio_read_32(rlockr), mmio_read_32(cidcfgr));
+}
+
+#define STM32MP25_PWR_RSECCFGR U(0x100)
+#define STM32MP25_PWR_RPRIVCFGR U(0x104)
+#define STM32MP25_PWR_RCIDCFGR(id) (U(0x108) + U(0x4) * (id))
+
+static void stm32mp25_pwr_unlock_resource(unsigned int id, const char *name)
+{
+	uint32_t bit = BIT_32(id);
+	uintptr_t seccfgr = PWR_BASE + STM32MP25_PWR_RSECCFGR;
+	uintptr_t privcfgr = PWR_BASE + STM32MP25_PWR_RPRIVCFGR;
+	uintptr_t cidcfgr = PWR_BASE + STM32MP25_PWR_RCIDCFGR(id);
+	uint32_t sec = mmio_read_32(seccfgr);
+	uint32_t priv = mmio_read_32(privcfgr);
+	uint32_t cid = mmio_read_32(cidcfgr);
+
+	NOTICE("PWR RIF: %s before sec=%x priv=%x cid=%x\n",
+	       name, sec, priv, cid);
+
+	mmio_clrbits_32(seccfgr, bit);
+	mmio_clrbits_32(privcfgr, bit);
+	mmio_write_32(cidcfgr, 0U);
+
+	NOTICE("PWR RIF: %s after sec=%x priv=%x cid=%x\n",
+	       name, mmio_read_32(seccfgr), mmio_read_32(privcfgr),
+	       mmio_read_32(cidcfgr));
+}
+#endif
