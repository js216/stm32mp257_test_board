From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: agent3 <agent3@localhost>
Date: Tue, 9 Jun 2026 18:05:00 -0700
Subject: [PATCH] stm32mp257-dk: disable crypto and RNG nodes in OP-TEE DT

The RIFSC bus probe firewall-checks every enabled child node and
panics now that HASH/PKA/SAES/RNG are non-secure (drivers are already
off via CFG_STM32_*=n). Disable the nodes so the bus probe skips them.

---
diff --git a/core/arch/arm/dts/stm32mp257f-dk.dts b/core/arch/arm/dts/stm32mp257f-dk.dts
--- a/core/arch/arm/dts/stm32mp257f-dk.dts
+++ b/core/arch/arm/dts/stm32mp257f-dk.dts
@@ -51,7 +51,7 @@
 };
 
 &hash {
-	status = "okay";
+	status = "disabled";
 };
 
 &hsi_calibration {
@@ -325,7 +325,11 @@
 };
 
 &pka {
-	status = "okay";
+	status = "disabled";
+};
+
+&rng {
+	status = "disabled";
 };
 
 &pwr {
@@ -420,7 +424,7 @@
 };
 
 &saes {
-	status = "okay";
+	status = "disabled";
 };
 
 &scmi_regulator {
--
2.43.0
