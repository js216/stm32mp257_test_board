From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Fri, 5 Jun 2026 18:30:00 -0700
Subject: [PATCH] cpuidle: psci: keep PM domains when set mode fails

On STM32MP257F-DK the firmware advertises PSCI OSI support, but
PSCI_SET_SUSPEND_MODE returns NOT_SUPPORTED.  Treat that as an idle
state limitation instead of tearing down the genpd providers, because
non-CPU devices in the board devicetree depend on those power domains.

Keep the topology registered and leave PSCI domain idle states disabled
when the firmware rejects the suspend mode selection.

Signed-off-by: Codex <codex@local>
---
 drivers/cpuidle/cpuidle-psci-domain.c | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/drivers/cpuidle/cpuidle-psci-domain.c b/drivers/cpuidle/cpuidle-psci-domain.c
index 09091dd22a78..a14506aab1cc 100644
--- a/drivers/cpuidle/cpuidle-psci-domain.c
+++ b/drivers/cpuidle/cpuidle-psci-domain.c
@@ -28,6 +28,7 @@ struct psci_pd_provider {
 
 static LIST_HEAD(psci_pd_providers);
 static bool psci_pd_allow_domain_state;
+static bool psci_pd_osi_mode;
 
 static int psci_pd_power_off(struct generic_pm_domain *pd)
 {
@@ -38,7 +39,7 @@ static int psci_pd_power_off(struct generic_pm_domain *pd)
 	if (!state->data)
 		return 0;
 
-	if (!psci_pd_allow_domain_state)
+	if (!psci_pd_allow_domain_state || !psci_pd_osi_mode)
 		return -EBUSY;
 
 	/* OSI mode is enabled, set the corresponding domain state. */
@@ -149,8 +150,14 @@ static int psci_cpuidle_domain_probe(struct platform_device *pdev)
 
 	/* let's try to enable OSI. */
 	ret = psci_set_osi_mode(use_osi);
-	if (ret)
-		goto remove_pd;
+	if (ret) {
+		pr_warn("failed to set %s mode: %d, keeping CPU PM domains idle-disabled\n",
+			use_osi ? "OSI" : "PC", ret);
+		use_osi = false;
+		ret = 0;
+	}
+
+	psci_pd_osi_mode = use_osi;
 
 	pr_info("Initialized CPU PM domain topology using %s mode\n",
 		use_osi ? "OSI" : "PC");
-- 
