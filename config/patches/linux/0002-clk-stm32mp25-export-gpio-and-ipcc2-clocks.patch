From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Tue, 9 Jun 2026 00:00:00 -0700
Subject: [PATCH] clk: stm32mp25: export GPIO and IPCC2 RCC clocks

The driver already defines the clock-summary gate objects for GPIOA..GPIOZ
and IPCC2, but the device-tree clock provider table does not expose the
corresponding clock IDs. This makes native RCC users fail with -ENOENT and
forces those consumers to keep using SCMI clocks.

Export the same gates that OP-TEE exposes. The gate bits match the RCC
configuration registers documented in RM0457.

Signed-off-by: Codex <codex@local>
---
 drivers/clk/stm32/clk-stm32mp25.c | 106 +++++++++++++++++++++++++++++++++++++
 1 file changed, 106 insertions(+)

diff --git a/drivers/clk/stm32/clk-stm32mp25.c b/drivers/clk/stm32/clk-stm32mp25.c
index 09f5b41540cb..1731135da4d5 100644
--- a/drivers/clk/stm32/clk-stm32mp25.c
+++ b/drivers/clk/stm32/clk-stm32mp25.c
@@ -42,6 +42,19 @@
 #define STM32MP25_RIFRCC_DBG_ID		73
 #define STM32MP25_RIFRCC_IS2M_ID	107
 #define STM32MP25_RIFRCC_MCO1_ID	108
+#define STM32MP25_RIFRCC_IPCC2_ID	88
+#define STM32MP25_RIFRCC_GPIOA_ID	90
+#define STM32MP25_RIFRCC_GPIOB_ID	91
+#define STM32MP25_RIFRCC_GPIOC_ID	92
+#define STM32MP25_RIFRCC_GPIOD_ID	93
+#define STM32MP25_RIFRCC_GPIOE_ID	94
+#define STM32MP25_RIFRCC_GPIOF_ID	95
+#define STM32MP25_RIFRCC_GPIOG_ID	96
+#define STM32MP25_RIFRCC_GPIOH_ID	97
+#define STM32MP25_RIFRCC_GPIOI_ID	98
+#define STM32MP25_RIFRCC_GPIOJ_ID	99
+#define STM32MP25_RIFRCC_GPIOK_ID	100
+#define STM32MP25_RIFRCC_GPIOZ_ID	101
 #define STM32MP25_RIFRCC_MCO2_ID	109
 #define STM32MP25_RIFRCC_OSPI1_ID	110
 #define STM32MP25_RIFRCC_OSPI2_ID	111
@@ -1227,6 +1240,84 @@ static struct clk_stm32_gate ck_icn_p_is2m = {
 	.hw.init = CLK_HW_INIT_INDEX("ck_icn_p_is2m", ICN_APB3, &clk_stm32_gate_ops, 0),
 };
 
+/* GPIO and IPCC2 */
+static struct clk_stm32_gate ck_icn_p_ipcc2 = {
+	.gate_id = GATE_IPCC2,
+	.hw.init = CLK_HW_INIT_INDEX("ck_icn_p_ipcc2", ICN_LS_MCU, &clk_stm32_gate_ops, 0),
+};
+
+static struct clk_stm32_gate ck_icn_p_ipcc2_am = {
+	.gate_id = GATE_IPCC2AM,
+	.hw.init = CLK_HW_INIT_HW("ck_icn_p_ipcc2_am", &ck_icn_p_ipcc2.hw,
+				  &clk_stm32_gate_ops, 0),
+};
+
+static struct clk_stm32_gate ck_icn_p_gpioa = {
+	.gate_id = GATE_GPIOA,
+	.hw.init = CLK_HW_INIT_INDEX("ck_icn_p_gpioa", ICN_LS_MCU, &clk_stm32_gate_ops, 0),
+};
+
+static struct clk_stm32_gate ck_icn_p_gpiob = {
+	.gate_id = GATE_GPIOB,
+	.hw.init = CLK_HW_INIT_INDEX("ck_icn_p_gpiob", ICN_LS_MCU, &clk_stm32_gate_ops, 0),
+};
+
+static struct clk_stm32_gate ck_icn_p_gpioc = {
