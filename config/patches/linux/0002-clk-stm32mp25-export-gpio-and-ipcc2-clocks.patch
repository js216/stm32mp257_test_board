+	.hw.init = CLK_HW_INIT_INDEX("ck_icn_p_gpiok", ICN_LS_MCU, &clk_stm32_gate_ops, 0),
+};
+
+static struct clk_stm32_gate ck_icn_p_gpioz = {
+	.gate_id = GATE_GPIOZ,
+	.hw.init = CLK_HW_INIT_INDEX("ck_icn_p_gpioz", ICN_LS_MCU, &clk_stm32_gate_ops, 0),
+};
+
+static struct clk_stm32_gate ck_icn_p_gpioz_am = {
+	.gate_id = GATE_GPIOZAM,
+	.hw.init = CLK_HW_INIT_HW("ck_icn_p_gpioz_am", &ck_icn_p_gpioz.hw,
+				  &clk_stm32_gate_ops, 0),
+};
+
 /* IWDG */
 static struct clk_stm32_gate ck_icn_p_iwdg1 = {
 	.gate_id = GATE_IWDG1,
@@ -2004,6 +2017,21 @@ static const struct clock_config stm32mp25_clock_cfg[] = {
 	STM32_GATE_CFG(CK_BUS_CRYP2, ck_icn_p_cryp2, SEC_RIFSC(97)),
 	STM32_GATE_CFG(CK_BUS_SAES, ck_icn_p_saes, SEC_RIFSC(94)),
 	STM32_GATE_CFG(CK_BUS_PKA, ck_icn_p_pka, SEC_RIFSC(93)),
+	STM32_GATE_CFG(CK_BUS_IPCC2, ck_icn_p_ipcc2, SEC_RIFRCC(IPCC2)),
+	STM32_GATE_CFG(CK_IPCC2_AM, ck_icn_p_ipcc2_am, SEC_RIFRCC(IPCC2)),
+	STM32_GATE_CFG(CK_BUS_GPIOA, ck_icn_p_gpioa, SEC_RIFRCC(GPIOA)),
+	STM32_GATE_CFG(CK_BUS_GPIOB, ck_icn_p_gpiob, SEC_RIFRCC(GPIOB)),
+	STM32_GATE_CFG(CK_BUS_GPIOC, ck_icn_p_gpioc, SEC_RIFRCC(GPIOC)),
+	STM32_GATE_CFG(CK_BUS_GPIOD, ck_icn_p_gpiod, SEC_RIFRCC(GPIOD)),
+	STM32_GATE_CFG(CK_BUS_GPIOE, ck_icn_p_gpioe, SEC_RIFRCC(GPIOE)),
+	STM32_GATE_CFG(CK_BUS_GPIOF, ck_icn_p_gpiof, SEC_RIFRCC(GPIOF)),
+	STM32_GATE_CFG(CK_BUS_GPIOG, ck_icn_p_gpiog, SEC_RIFRCC(GPIOG)),
+	STM32_GATE_CFG(CK_BUS_GPIOH, ck_icn_p_gpioh, SEC_RIFRCC(GPIOH)),
+	STM32_GATE_CFG(CK_BUS_GPIOI, ck_icn_p_gpioi, SEC_RIFRCC(GPIOI)),
+	STM32_GATE_CFG(CK_BUS_GPIOJ, ck_icn_p_gpioj, SEC_RIFRCC(GPIOJ)),
+	STM32_GATE_CFG(CK_BUS_GPIOK, ck_icn_p_gpiok, SEC_RIFRCC(GPIOK)),
+	STM32_GATE_CFG(CK_BUS_GPIOZ, ck_icn_p_gpioz, SEC_RIFRCC(GPIOZ)),
+	STM32_GATE_CFG(CK_GPIOZ_AM, ck_icn_p_gpioz_am, SEC_RIFRCC(GPIOZ)),
 	STM32_GATE_CFG(CK_BUS_ADF1, ck_icn_p_adf1, SEC_RIFSC(55)),
 	STM32_GATE_CFG(CK_BUS_SPI8, ck_icn_p_spi8, SEC_RIFSC(29)),
 	STM32_GATE_CFG(CK_BUS_LPUART1, ck_icn_p_lpuart1, SEC_RIFSC(40)),
-- 
