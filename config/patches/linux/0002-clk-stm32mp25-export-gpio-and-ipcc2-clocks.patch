+	.hw.init = CLK_HW_INIT_INDEX("ck_icn_p_gpioc", ICN_LS_MCU, &clk_stm32_gate_ops, 0),
+};
+
+static struct clk_stm32_gate ck_icn_p_gpiod = {
+	.gate_id = GATE_GPIOD,
+	.hw.init = CLK_HW_INIT_INDEX("ck_icn_p_gpiod", ICN_LS_MCU, &clk_stm32_gate_ops, 0),
+};
+
+static struct clk_stm32_gate ck_icn_p_gpioe = {
+	.gate_id = GATE_GPIOE,
+	.hw.init = CLK_HW_INIT_INDEX("ck_icn_p_gpioe", ICN_LS_MCU, &clk_stm32_gate_ops, 0),
+};
+
+static struct clk_stm32_gate ck_icn_p_gpiof = {
+	.gate_id = GATE_GPIOF,
+	.hw.init = CLK_HW_INIT_INDEX("ck_icn_p_gpiof", ICN_LS_MCU, &clk_stm32_gate_ops, 0),
+};
+
+static struct clk_stm32_gate ck_icn_p_gpiog = {
+	.gate_id = GATE_GPIOG,
+	.hw.init = CLK_HW_INIT_INDEX("ck_icn_p_gpiog", ICN_LS_MCU, &clk_stm32_gate_ops, 0),
+};
+
+static struct clk_stm32_gate ck_icn_p_gpioh = {
+	.gate_id = GATE_GPIOH,
+	.hw.init = CLK_HW_INIT_INDEX("ck_icn_p_gpioh", ICN_LS_MCU, &clk_stm32_gate_ops, 0),
+};
+
+static struct clk_stm32_gate ck_icn_p_gpioi = {
+	.gate_id = GATE_GPIOI,
+	.hw.init = CLK_HW_INIT_INDEX("ck_icn_p_gpioi", ICN_LS_MCU, &clk_stm32_gate_ops, 0),
+};
+
+static struct clk_stm32_gate ck_icn_p_gpioj = {
