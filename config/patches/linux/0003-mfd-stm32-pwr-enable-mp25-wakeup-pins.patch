From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: agent3 <agent3@localhost>
Date: Tue, 9 Jun 2026 10:12:00 -0700
Subject: [PATCH] mfd: stm32-pwr: enable MP25 wakeup pins

STM32MP25 exposes one PWR_WKUPCR register per wake pin. Add a variant
path for the MP25 layout while keeping the existing STM32MP1 SMC path
unchanged.

Signed-off-by: agent3 <agent3@localhost>
---
--- a/drivers/mfd/Kconfig
+++ b/drivers/mfd/Kconfig
@@ -2131,7 +2131,7 @@
 
 config MFD_STM32MP1_PWR
 	bool "STM32MP1 wake-up pins"
-	depends on MACH_STM32MP157
+	depends on MACH_STM32MP157 || ARCH_STM32 || COMPILE_TEST
 	default y
 	help
 	  Select this option to enable STM32 PWR Wake-up pins driver.
--- a/drivers/mfd/stm32-pwr.c
+++ b/drivers/mfd/stm32-pwr.c
@@ -11,6 +11,7 @@
 #include <linux/irqchip/chained_irq.h>
 #include <linux/module.h>
 #include <linux/of_address.h>
+#include <linux/of_device.h>
 #include <linux/of_gpio.h>
 #include <linux/of_irq.h>
 #include <linux/platform_device.h>
@@ -30,12 +31,25 @@
 #define MPUWKUPENR 0x8
 
 #define WKUP_FLAGS_MASK GENMASK(5, 0)
+#define MP25_WKUPCR1 0x60
 
 // WKUPCR bits definition
 #define WKUP_EDGE_SHIFT 8
 #define WKUP_PULL_SHIFT 16
 #define WKUP_PULL_MASK GENMASK(1, 0)
 
+// MP25 PWR_WKUPCRx bits definition
+#define MP25_WKUPC BIT(0)
+#define MP25_WKUPP BIT(8)
+#define MP25_WKUPPUPD_SHIFT 12
+#define MP25_WKUPPUPD_MASK GENMASK(13, 12)
+#define MP25_WKUPENCPU1 BIT(16)
+#define MP25_WKUPF BIT(31)
+
+struct stm32_pwr_variant {
+	bool mp25;
+};
+
 enum wkup_pull_setting {
 	WKUP_NO_PULL = 0,
 	WKUP_PULL_UP,
@@ -58,14 +72,54 @@
 	u32 wake;			/* IRQ is wake on */
 	u32 pending;			/* IRQ has been received while wake on*/
 	int gpio[NB_WAKEUPPINS];
+	const struct stm32_pwr_variant *variant;
 };
 
+static bool stm32_pwr_is_mp25(struct stm32_pwr_data *priv)
+{
+	return priv->variant && priv->variant->mp25;
+}
+
+static u32 stm32_pwr_mp25_wkupcr(unsigned long pin)
+{
+	return MP25_WKUPCR1 + pin * sizeof(u32);
+}
+
+static void stm32_pwr_write(struct stm32_pwr_data *priv, u32 offset, u32 val)
+{
+	if (stm32_pwr_is_mp25(priv))
+		writel_relaxed(val, priv->base + offset);
+	else
+		SMC(STM32_SVC_PWR, STM32_WRITE, offset, val);
+}
+
+static void stm32_pwr_set_bits(struct stm32_pwr_data *priv, u32 offset, u32 bits)
+{
+	if (stm32_pwr_is_mp25(priv))
+		writel_relaxed(readl_relaxed(priv->base + offset) | bits,
+			       priv->base + offset);
+	else
+		SMC(STM32_SVC_PWR, STM32_SET_BITS, offset, bits);
+}
+
+static void stm32_pwr_clear_bits(struct stm32_pwr_data *priv, u32 offset, u32 bits)
+{
+	if (stm32_pwr_is_mp25(priv))
+		writel_relaxed(readl_relaxed(priv->base + offset) & ~bits,
+			       priv->base + offset);
+	else
+		SMC(STM32_SVC_PWR, STM32_CLEAR_BITS, offset, bits);
+}
+
 static void stm32_pwr_irq_ack(struct irq_data *d)
 {
 	struct stm32_pwr_data *priv = d->domain->host_data;
 
 	dev_dbg(priv->dev, "irq:%lu\n", d->hwirq);
-	SMC(STM32_SVC_PWR, STM32_SET_BITS, WKUPCR, BIT(d->hwirq));
+	if (stm32_pwr_is_mp25(priv))
+		stm32_pwr_set_bits(priv, stm32_pwr_mp25_wkupcr(d->hwirq), MP25_WKUPC);
+	else
+		stm32_pwr_set_bits(priv, WKUPCR, BIT(d->hwirq));
 }
 
 static void stm32_pwr_irq_set_state(struct irq_data *d)
@@ -75,10 +129,16 @@
 	dev_dbg(priv->dev, "irq:%lu\n", d->hwirq);
 
 	/* enable is not masker or wake enabled */
-	if (!(priv->masked & BIT(d->hwirq)) || (priv->wake & BIT(d->hwirq)))
-		SMC(STM32_SVC_PWR, STM32_SET_BITS, MPUWKUPENR, BIT(d->hwirq));
-	else
-		SMC(STM32_SVC_PWR, STM32_CLEAR_BITS, MPUWKUPENR, BIT(d->hwirq));
+	if (!(priv->masked & BIT(d->hwirq)) || (priv->wake & BIT(d->hwirq))) {
+		if (stm32_pwr_is_mp25(priv))
+			stm32_pwr_set_bits(priv, stm32_pwr_mp25_wkupcr(d->hwirq), MP25_WKUPENCPU1);
+		else
+			stm32_pwr_set_bits(priv, MPUWKUPENR, BIT(d->hwirq));
+	} else if (stm32_pwr_is_mp25(priv)) {
+		stm32_pwr_clear_bits(priv, stm32_pwr_mp25_wkupcr(d->hwirq), MP25_WKUPENCPU1);
+	} else {
+		stm32_pwr_clear_bits(priv, MPUWKUPENR, BIT(d->hwirq));
+	}
 }
 
 static void stm32_pwr_irq_mask(struct irq_data *d)
@@ -113,7 +173,7 @@
 	}
 	stm32_pwr_irq_set_state(d);
 
-	if (parent->chip && parent->chip->irq_set_wake)
+	if (parent && parent->chip && parent->chip->irq_set_wake)
 		return parent->chip->irq_set_wake(parent, on);
 
 	return 0;
@@ -128,26 +188,38 @@
 
 	dev_dbg(priv->dev, "irq:%lu\n", d->hwirq);
 
-	en = readl_relaxed(priv->base + MPUWKUPENR) & BIT(pin_id);
+	if (stm32_pwr_is_mp25(priv))
+		en = readl_relaxed(priv->base + stm32_pwr_mp25_wkupcr(pin_id)) & MP25_WKUPENCPU1;
+	else
+		en = readl_relaxed(priv->base + MPUWKUPENR) & BIT(pin_id);
 	/* reference manual request to disable the wakeup pin while
 	 * changing the edge detection setting
 	 */
 	if (en)
 		stm32_pwr_irq_mask(d);
 
-	wkupcr = readl_relaxed(priv->base + WKUPCR);
+	wkupcr = readl_relaxed(priv->base +
+			       (stm32_pwr_is_mp25(priv) ? stm32_pwr_mp25_wkupcr(pin_id) : WKUPCR));
 	switch (flow_type & IRQ_TYPE_SENSE_MASK) {
 	case IRQF_TRIGGER_FALLING:
-		wkupcr |= (1 << (WKUP_EDGE_SHIFT + pin_id));
+		if (stm32_pwr_is_mp25(priv))
+			wkupcr |= MP25_WKUPP;
+		else
+			wkupcr |= (1 << (WKUP_EDGE_SHIFT + pin_id));
 		break;
 	case IRQF_TRIGGER_RISING:
-		wkupcr &= ~(1 << (WKUP_EDGE_SHIFT + pin_id));
+		if (stm32_pwr_is_mp25(priv))
+			wkupcr &= ~MP25_WKUPP;
+		else
+			wkupcr &= ~(1 << (WKUP_EDGE_SHIFT + pin_id));
 		break;
 	default:
 		return -EINVAL;
 	}
 
-	SMC(STM32_SVC_PWR, STM32_WRITE, WKUPCR, wkupcr);
+	stm32_pwr_write(priv,
+			stm32_pwr_is_mp25(priv) ? stm32_pwr_mp25_wkupcr(pin_id) : WKUPCR,
+			wkupcr);
 
 	if (en)
 		stm32_pwr_irq_unmask(d);
@@ -164,7 +236,7 @@
 
 	irq_data_update_effective_affinity(data, dest);
 
-	if (parent->chip && parent->chip->irq_set_affinity)
+	if (parent && parent->chip && parent->chip->irq_set_affinity)
 		return parent->chip->irq_set_affinity(parent, dest, force);
 
 	return IRQ_SET_MASK_OK_DONE;
@@ -231,11 +303,19 @@
 		return -EINVAL;
 	}
 
-	wkupcr = readl_relaxed(priv->base + WKUPCR);
-	wkupcr &= ~((WKUP_PULL_MASK) << (WKUP_PULL_SHIFT + pin_id * 2));
-	wkupcr |= (config & WKUP_PULL_MASK) << (WKUP_PULL_SHIFT + pin_id * 2);
+	if (stm32_pwr_is_mp25(priv)) {
+		u32 offset = stm32_pwr_mp25_wkupcr(pin_id);
 
-	SMC(STM32_SVC_PWR, STM32_WRITE, WKUPCR, wkupcr);
+		wkupcr = readl_relaxed(priv->base + offset);
+		wkupcr &= ~MP25_WKUPPUPD_MASK;
+		wkupcr |= (config & WKUP_PULL_MASK) << MP25_WKUPPUPD_SHIFT;
+		stm32_pwr_write(priv, offset, wkupcr);
+	} else {
+		wkupcr = readl_relaxed(priv->base + WKUPCR);
+		wkupcr &= ~((WKUP_PULL_MASK) << (WKUP_PULL_SHIFT + pin_id * 2));
+		wkupcr |= (config & WKUP_PULL_MASK) << (WKUP_PULL_SHIFT + pin_id * 2);
+		stm32_pwr_write(priv, WKUPCR, wkupcr);
+	}
 
 	return 0;
 }
@@ -285,6 +365,20 @@
 
 	chained_irq_enter(chip, desc);
 
+	if (stm32_pwr_is_mp25(priv)) {
+		for (i = 0; i < NB_WAKEUPPINS; i++) {
+			u32 wkupcr = readl_relaxed(priv->base + stm32_pwr_mp25_wkupcr(i));
+
+			if ((wkupcr & MP25_WKUPF) && (wkupcr & MP25_WKUPENCPU1)) {
+				struct irq_desc *d = irq_to_desc(irq_find_mapping(priv->domain, i));
+
+				handle_edge_irq(d);
+			}
+		}
+		chained_irq_exit(chip, desc);
+		return;
+	}
+
 	wkupfr = readl_relaxed(priv->base + WKUPFR);
 	wkupenr = readl_relaxed(priv->base + MPUWKUPENR);
 
@@ -335,6 +429,7 @@
 		return -ENOMEM;
 	priv->dev = dev;
 	dev_set_drvdata(dev, priv);
+	priv->variant = of_device_get_match_data(dev);
 
 	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
 	priv->base = devm_ioremap_resource(dev, res);
@@ -344,9 +439,18 @@
 	}
 
 	/* Disable all wake-up pins */
-	SMC(STM32_SVC_PWR, STM32_WRITE, MPUWKUPENR, 0);
-	/* Clear all interrupts flags */
-	SMC(STM32_SVC_PWR, STM32_SET_BITS, WKUPCR, WKUP_FLAGS_MASK);
+	if (stm32_pwr_is_mp25(priv)) {
+		unsigned int i;
+
+		for (i = 0; i < NB_WAKEUPPINS; i++) {
+			stm32_pwr_clear_bits(priv, stm32_pwr_mp25_wkupcr(i), MP25_WKUPENCPU1);
+			stm32_pwr_set_bits(priv, stm32_pwr_mp25_wkupcr(i), MP25_WKUPC);
+		}
+	} else {
+		stm32_pwr_write(priv, MPUWKUPENR, 0);
+		/* Clear all interrupts flags */
+		stm32_pwr_set_bits(priv, WKUPCR, WKUP_FLAGS_MASK);
+	}
 
 	priv->domain = irq_domain_add_linear(np, NB_WAKEUPPINS,
 					     &stm32_pwr_irq_domain_ops, priv);
@@ -357,9 +461,9 @@
 	}
 
 	ret = irq_of_parse_and_map(np, 0);
-	if (ret < 0) {
+	if (ret <= 0) {
 		dev_err(dev, "failed to get PWR IRQ\n");
-		ret = priv->irq;
+		ret = -EPROBE_DEFER;
 		goto out_domain;
 	}
 
@@ -384,8 +488,13 @@
 	return 0;
 }
 
+static const struct stm32_pwr_variant stm32mp25_pwr_variant = {
+	.mp25 = true,
+};
+
 static const struct of_device_id stm32_pwr_ids[] = {
 	{ .compatible = "st,stm32mp1-pwr", },
+	{ .compatible = "st,stm32mp25-pwr", .data = &stm32mp25_pwr_variant },
 	{},
 };
 MODULE_DEVICE_TABLE(of, stm32_pwr_ids);
